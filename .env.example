# ============================================================
# SMART GAS MANAGEMENT - Environment Variables
# ============================================================
# HƯỚNG DẪN:
# 1. Copy file này thành file tên ".env" (bỏ ".example")
# 2. Điền thông tin thật vào file ".env"
# 3. File ".env" đã được thêm vào .gitignore - KHÔNG lên Git
# 4. KHÔNG share file .env qua chat/email - dùng kênh bảo mật
# ============================================================

# ── MongoDB Atlas ──────────────────────────────────────────
# Lấy connection string từ: MongoDB Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/<DATABASE>?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=gas_management_db

# ── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ── JWT ────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên tại: https://generate-secret.vercel.app/64
JWT_SECRET=your-super-secret-key-minimum-256-bits-change-this
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
