# ============================================================
# SMART GAS MANAGEMENT - .gitignore
# ============================================================

# ── Credentials - TUYỆT ĐỐI KHÔNG commit lên Git ──────────
.env
*.env
!.env.example

# ── Maven ──────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.code-workspace

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────
*.log
logs/
